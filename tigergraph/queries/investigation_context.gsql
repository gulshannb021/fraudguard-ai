CREATE QUERY investigation_context(STRING txn_id) FOR GRAPH CustomerTransactionGraph {

    Tx = SELECT t
         FROM Transaction:t
         WHERE t.id == txn_id;

    Cards = SELECT c
            FROM Tx:t -(used_card>)- Card:c;

    Customers = SELECT cu
                FROM Cards:c -(reverse_owns>)- Customer:cu;

    RelatedTransactions = SELECT t2
                          FROM Cards:c -(made_transaction>)- Transaction:t2;

    PRINT Tx;
    PRINT Cards;
    PRINT Customers;
    PRINT RelatedTransactions;
}